# 生成: scripts/render_config.py（site: example-vlan.yaml、VyOS 2026.10.16-0024-rolling）。手で直さず、テンプレート（vyos/prod/50-monitor.cmds.j2）か site を直して描き直す
# 監視: SNMP（読み取り専用の v2c）と node-exporter。どちらも VRF MGMT の中（eth0）で待ち受ける
# vyos/snmp-mgmt.cmds の形。network を明示して既定の 0.0.0.0/0 ::/0 を消す。
# 秘密の値（community）は印 @SNMP_COMMUNITY@ のまま出し、投入時に環境変数 SNMP_COMMUNITY で置き換える
set service snmp community '@SNMP_COMMUNITY@' authorization 'ro'
set service snmp community '@SNMP_COMMUNITY@' network '192.168.2.50/32'
set service snmp vrf 'MGMT'
set service monitoring prometheus node-exporter vrf 'MGMT'
