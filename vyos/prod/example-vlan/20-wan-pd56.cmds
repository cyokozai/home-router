# 生成: scripts/render_config.py（site: example-vlan.yaml、VyOS 2026.10.16-0024-rolling）。手で直さず、テンプレート（vyos/prod/20-wan-pd56.cmds.j2）か site を直して描き直す
# 型A: ONU 直結で DHCPv6-PD の /56 を受ける（光クロス、ひかり電話なし）
# サブネット ID 0 は MAP-E の CE 用なので、LAN には 1 を使う
set interfaces ethernet eth2 dhcpv6-options pd 0 length '56'
# VLAN で分けた網ごとに、site の sla_id のサブネット ID の /64 を付ける
set interfaces ethernet eth2 dhcpv6-options pd 0 interface br0.10 sla-id '1'
set interfaces ethernet eth2 dhcpv6-options pd 0 interface br0.10 address '1'
set interfaces ethernet eth2 dhcpv6-options pd 0 interface br0.20 sla-id '2'
set interfaces ethernet eth2 dhcpv6-options pd 0 interface br0.20 address '1'
set interfaces ethernet eth2 dhcpv6-options pd 0 interface br0.30 sla-id '3'
set interfaces ethernet eth2 dhcpv6-options pd 0 interface br0.30 address '1'
set interfaces ethernet eth2 dhcpv6-options pd 0 interface br0.40 sla-id '4'
set interfaces ethernet eth2 dhcpv6-options pd 0 interface br0.40 address '1'
set interfaces ethernet eth2 dhcpv6-options pd 0 interface br0.50 sla-id '5'
set interfaces ethernet eth2 dhcpv6-options pd 0 interface br0.50 address '1'
