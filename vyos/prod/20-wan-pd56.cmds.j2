# 型A: ONU 直結で DHCPv6-PD の /56 を受ける（光クロス、ひかり電話なし）
# サブネット ID 0 は MAP-E の CE 用なので、LAN には 1 を使う
set interfaces ethernet {{ i.wan }} dhcpv6-options pd 0 length '56'
{% if lan.bridge %}
# VLAN で分けた網ごとに、site の sla_id のサブネット ID の /64 を付ける
{% for n in lan.bridge.nets %}
set interfaces ethernet {{ i.wan }} dhcpv6-options pd 0 interface {{ n.ifname }} sla-id '{{ n.sla_id }}'
set interfaces ethernet {{ i.wan }} dhcpv6-options pd 0 interface {{ n.ifname }} address '1'
{% endfor %}
{% else %}
set interfaces ethernet {{ i.wan }} dhcpv6-options pd 0 interface {{ i.lan }} sla-id '1'
set interfaces ethernet {{ i.wan }} dhcpv6-options pd 0 interface {{ i.lan }} address '1'
{% endif %}
