# 生成: scripts/render_config.py（site: example.yaml、VyOS 2026.10.16-0024-rolling）。手で直さず、テンプレート（vyos/prod/20-wan-pd60.cmds.j2）か site を直して描き直す
# 型B: HGW の配下で DHCPv6-PD の /60 を受ける
# サブネット ID 0 は使わず、LAN には 1 を使う。MAP-E の値は WAN で観測した /64 から計算する（scripts/mape_calc.py --help）
set interfaces ethernet eth2 dhcpv6-options pd 0 length '60'
set interfaces ethernet eth2 dhcpv6-options pd 0 interface eth1 sla-id '1'
set interfaces ethernet eth2 dhcpv6-options pd 0 interface eth1 address '1'
