# 生成: scripts/render_config.py（site: example.yaml、VyOS 2026.10.16-0024-rolling）。手で直さず、テンプレート（vyos/prod/20-wan-common.cmds.j2）か site を直して描き直す
# WAN（NGN）の共通部分。RA を受けて既定経路を作る（ipv6 address autoconf で accept_ra=2 になる）
# トンネルの外側のトラフィッククラス（tun0 parameters ipv6 tclass '0x00'）は、tun0 を作る MAP-E の段（40-mape、
# scripts/mape_calc.py）に入っている。tun0 の残りの設定が無いままここで書くと、トンネルが作れず commit が通らない
set interfaces ethernet eth2 description 'WAN-NGN'
set interfaces ethernet eth2 ipv6 address autoconf
# DHCPv6 の DUID を DUID-LL（種別 3・Ethernet・WAN の MAC）にする。光クロスは DUID-LL か DUID-LLT でないと PD に答えない
# （NTT東「IP通信網サービスのインタフェース 第三分冊」第46版 4.4.2.1.4）。VyOS の既定は DUID-UUID（種別 4）
set interfaces ethernet eth2 dhcpv6-options duid '00:03:00:01:02:00:00:00:00:01'
